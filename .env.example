# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=clinagenda
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=clinagenda
DATABASE_URL=postgresql://clinagenda:cambia-esta-clave@localhost:5432/clinagenda?schema=public

# --- API ---
API_PORT=4000
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Origen permitido para CORS (la web)
WEB_ORIGIN=http://localhost:3000
# Clave inicial de los usuarios de demostración creados por el seed
SEED_DEMO_PASSWORD=Demo2026!

# --- Web ---
# URL pública de la API vista desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Respaldos ---
# Cada cuántas horas se hace un respaldo y cuántos se conservan
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
