# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=clinagenda
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=clinagenda
DATABASE_URL=postgresql://clinagenda:cambia-esta-clave@localhost:5432/clinagenda?schema=public

# --- API ---
API_PORT=4000
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Clave inicial de los usuarios de demostración creados por el seed
SEED_DEMO_PASSWORD=Demo2026!

# Producción: dominio público (las 3 clínicas entran por https://DOMAIN) y cookie solo por HTTPS.
# Se activa con: docker compose --profile produccion up -d
DOMAIN=agenda.ejemplo.ec
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Si la base está vacía al arrancar, la llena según SEED_MODE:
#   demo    = datos de demostración inventados (para probar)
#   inicial = instalación real: solo las 3 clínicas y el usuario "admin" con la clave SEED_DEMO_PASSWORD
SEED_ON_START=true
SEED_MODE=demo

# --- Web (solo para desarrollo local sin Docker) ---
# Dónde está la API; la web reenvía /api/* a esta dirección
API_INTERNAL_URL=http://localhost:4000

# --- Respaldos ---
# Cada cuántas horas se hace un respaldo y cuántos se conservan
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Carpeta FUERA del servidor donde se copia cada respaldo: un disco externo montado
# (ej. /media/respaldos) o una carpeta sincronizada con Google Drive / OneDrive.
BACKUP_COPY_PATH=./backups-copia
