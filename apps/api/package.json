{
  "name": "@clinagenda/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de ClinAgenda (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "node dist-seed/seed.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clinagenda/schemas": "0.1.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "nestjs-zod": "5.6.0",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.2",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
